#!/bin.bash

LABEL_DIR="NAV_Labels"
NCAM_DIR="ncam"
OUT_IMG="images"
OUT_LABEL="labels"


for file in "$LABEL_DIR"/*; do

    filename=$(basename "$file")

    if [[ "$filename" == *"_merged"* ]]; then
        short_name="${filename%_merged*}"

        match_found=$(find "$NCAM_DIR" -maxdepth 1 -name "*${short_name}*" | head -n 1)

        if [[ -n "match_found" ]]; then
            cp $(basename "$match_found") "images"
# Copy stuff to the right folders
        else
            continue
        fi


    else
        continue
    fi
done
